logging {
  level = "warn"
}

loki.source.file "aegisai" {
  targets = [
__TARGETS__
  ]
  tail_from_end = true
  forward_to = [loki.process.aegisai.receiver]
}

loki.process "aegisai" {
  stage.docker {}

  stage.json {
    expressions = {
      event_type = "event_type",
      status_code = "status_code",
    }
  }

  stage.labels {
    values = {
      event_type = "",
      status_code = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
