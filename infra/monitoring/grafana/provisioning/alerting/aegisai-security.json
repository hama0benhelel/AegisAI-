{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "aegisai-security",
      "folder": "AegisAI SOC",
      "interval": "30s",
      "rules": [
        {
          "uid": "aegisai-auth-failures",
          "title": "AegisAI — Refus d’authentification répétés",
          "condition": "B",
          "for": "30s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "labels": {
            "project": "aegisai",
            "severity": "warning"
          },
          "annotations": {
            "summary": "AegisAI — Refus d’authentification répétés",
            "description": "Au moins 5 refus dans une fenêtre de 5 minutes. Examiner les routes et Trace IDs avant de conclure à une attaque."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "aegisai-loki",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "loki",
                  "uid": "aegisai-loki"
                },
                "expr": "sum(count_over_time({job=\"aegisai\",service=\"backend\",event_type=~\"login_failure|authentication_rejected\"}[5m])) or vector(0)",
                "queryType": "instant",
                "instant": true,
                "range": false,
                "editorMode": "code",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "math",
                "expression": "$A >= 5",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
        {
          "uid": "aegisai-nginx-log-gap",
          "title": "AegisAI — Healthchecks absents des logs",
          "condition": "B",
          "for": "30s",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": false,
          "labels": {
            "project": "aegisai",
            "severity": "warning"
          },
          "annotations": {
            "summary": "AegisAI — Healthchecks absents des logs",
            "description": "Aucun healthcheck Nginx reçu depuis 2 minutes. Vérifier frontend, Alloy, chemins des logs et Loki. Cette alerte ne localise pas à elle seule la panne."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "aegisai-loki",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "loki",
                  "uid": "aegisai-loki"
                },
                "expr": "sum(absent_over_time({job=\"aegisai\",service=\"frontend\",event_type=\"nginx_access\"} | json | path=\"/healthz\" | __error__=\"\" [2m])) or vector(0)",
                "queryType": "instant",
                "instant": true,
                "range": false,
                "editorMode": "code",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "math",
                "expression": "$A > 0",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        }
      ]
    }
  ]
}