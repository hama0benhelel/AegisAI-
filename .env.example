# TEMPLATE ONLY. Copy to .env only on a NEW installation, never over existing secrets.
# Restrict the real .env to mode 0600. Empty values intentionally fail Compose validation.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# At least 64 characters; do not change on the existing VM during documentation updates.
JWT_SECRET=
# Must match the aegisai_security_reader login configured locally.
SECURITY_DB_PASSWORD=
# Must match the aegisai_simulator login configured locally.
SIMULATOR_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Compose currently requires a nonempty key even with LLM_ENABLED=false.
GROQ_API_KEY=
LLM_ENABLED=false
